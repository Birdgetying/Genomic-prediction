#!/bin/bash
# ============================================================================
# Generate wheat scatter plots ONLY (Fig 10): XGBoost + Stacking (Greedy)
# 使用: jsub < submit_wheat_figures.jsub
# 说明: 与其他脚本独立，不依赖 plot_all_figures.py
# ============================================================================
#JSUB -q gpu
#JSUB -n 2
#JSUB -gpgpu 1
#JSUB -J wheat_figures
#JSUB -o logs/wheat_figures_%J.out
#JSUB -e logs/wheat_figures_%J.err

echo "======================================================================"
echo "Wheat Figures — Job started at $(date)"
echo "======================================================================"

module load pytorch-2.3.0_py311
echo "Module loaded: pytorch-2.3.0_py311"

export PYTHONHASHSEED=42

cd /storage/public/home/2024110093/genomic_prediction || {
    echo "ERROR: Cannot find project directory"
    exit 1
}
echo "Working directory: $(pwd)"

# 确保 cyvcf2 已安装（wheat VCF 解析必需）
python -c "import cyvcf2" 2>/dev/null || {
    echo "Installing cyvcf2 from internal mirror..."
    pip install -i http://10.105.32.248/pypi/simple/ --trusted-host 10.105.32.248 cyvcf2
}

python -c "import torch; print(f'PyTorch {torch.__version__}'); print(f'CUDA: {torch.cuda.is_available()}')"

mkdir -p logs figures

echo ""
echo "======================================================================"
echo "Starting wheat scatter plot generation — $(date)"
echo "======================================================================"

T0=$(date +%s)
python -u plot_wheat_figures.py 2>&1
EXIT_CODE=$?
T1=$(date +%s)

echo ""
echo "======================================================================"
if [ $EXIT_CODE -eq 0 ]; then
    echo "SUCCESS — Total time: $(((T1-T0)/60)) min — $(date)"
    echo "Figures saved to: $(pwd)/figures/"
    ls -lh figures/*wheat*.png
else
    echo "FAILED with exit code $EXIT_CODE — $(date)"
fi
echo "======================================================================"
exit $EXIT_CODE
