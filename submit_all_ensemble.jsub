#!/bin/bash
# ============================================================================
# 全基因组预测集成系统 — 小麦 + 小麦2000 + 水稻 + 玉米 + 大豆 + 小麦GABI 超算 GPU 作业
# 包含 GWAS vs Random SNP 对照实验
#
# 使用: jsub < submit_all_ensemble.jsub
# ============================================================================
#JSUB -q gpu
#JSUB -n 2
#JSUB -gpgpu 1
#JSUB -J all_ensemble
#JSUB -o logs/all_ensemble_%J.out
#JSUB -e logs/all_ensemble_%J.err

echo "======================================================================"
echo "All Ensemble System (Wheat/Wheat2000/Rice/Maize/Soybean/WheatGABI) — $(date)"
echo "======================================================================"

module load pytorch-2.3.0_py311
echo "Module loaded: pytorch-2.3.0_py311"

export CUDA_VISIBLE_DEVICES=0
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:128
export CUDA_LAUNCH_BLOCKING=0
export PYTHONHASHSEED=42

# 工作目录
cd $HOME/genomic_prediction 2>/dev/null || \
cd /storage/public/home/2024110093/genomic_prediction 2>/dev/null || {
    echo "ERROR: Cannot find project directory"
    exit 1
}
echo "Working directory: $(pwd)"

# GPU 诊断
echo ""
echo "GPU Diagnostics:"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv 2>&1 || echo "nvidia-smi not available"
python -c "import torch; print(f'PyTorch {torch.__version__}'); print(f'CUDA: {torch.cuda.is_available()}')"

mkdir -p logs \
  results/wheat_ensemble results/wheat2000_ensemble results/rice_ensemble \
  results/maize_ensemble results/soybean_ensemble results/wheat_gabi_ensemble

EXIT_CODE=0
TOTAL_START=$(date +%s)

# ============================================================================
# 1. Wheat Ensemble (CSIAAS VCF data)
# ============================================================================
echo ""
echo "======================================================================"
echo "[1/6] WHEAT ENSEMBLE (CSIAAS) — $(date)"
echo "======================================================================"

DATA_BASE="/storage/public/home/2024110093/data/Variation/CSIAAS"
MISSING=0
for f in \
    "Core819Samples_snp.filter.final.id_gt.813m.vcf.gz" \
    "Core819Samples_indel.filter.final.id_gt.813m.vcf.gz" \
    "SV.new.vcf.gz" \
    "Phe.txt" \
    "VCFID.txt"
do
    if [ -f "$DATA_BASE/$f" ]; then
        echo "  [OK] $f"
    else
        echo "  [MISSING] $f"
        MISSING=1
    fi
done

if [ $MISSING -eq 1 ]; then
    echo "ERROR: Missing wheat data files, skipping"
else
    T0=$(date +%s)
    python -u genomic_ensemble.py wheat --full --no-plots 2>&1 | tee "logs/wheat_ensemble_$(date +%Y%m%d_%H%M%S).log"
    WHEAT_EXIT=${PIPESTATUS[0]}
    T1=$(date +%s)
    echo "Wheat finished in $(((T1-T0)/60)) min, exit=$WHEAT_EXIT"
    [ $WHEAT_EXIT -ne 0 ] && EXIT_CODE=$WHEAT_EXIT
fi

# ============================================================================
# 2. Wheat2000 Ensemble (CSV data, 2000 samples x 33K markers, 6 traits)
# ============================================================================
echo ""
echo "======================================================================"
echo "[2/6] WHEAT2000 ENSEMBLE — $(date)"
echo "======================================================================"

WHEAT2000_DATA="dnngp_data/wheat2000/SNP_origin"
MISSING=0
for f in \
    "$WHEAT2000_DATA/2000gene.csv" \
    "$WHEAT2000_DATA/2000_1_phe.txt" \
    "$WHEAT2000_DATA/2000_2_phe.txt" \
    "$WHEAT2000_DATA/2000_3_phe.txt" \
    "$WHEAT2000_DATA/2000_4_phe.txt" \
    "$WHEAT2000_DATA/2000_5_phe.txt" \
    "$WHEAT2000_DATA/2000_6_phe.txt"
do
    if [ -f "$f" ]; then
        echo "  [OK] $(basename $f)"
    else
        echo "  [MISSING] $f"
        MISSING=1
    fi
done

if [ $MISSING -eq 1 ]; then
    echo "ERROR: Missing wheat2000 data files, skipping"
else
    T0=$(date +%s)
    python -u genomic_ensemble.py wheat2000 --full --no-plots 2>&1 | tee "logs/wheat2000_ensemble_$(date +%Y%m%d_%H%M%S).log"
    W2000_EXIT=${PIPESTATUS[0]}
    T1=$(date +%s)
    echo "Wheat2000 finished in $(((T1-T0)/60)) min, exit=$W2000_EXIT"
    [ $W2000_EXIT -ne 0 ] && EXIT_CODE=$W2000_EXIT
fi

# ============================================================================
# 3. Rice Ensemble
# ============================================================================
echo ""
echo "======================================================================"
echo "[3/6] RICE ENSEMBLE — $(date)"
echo "======================================================================"

MISSING=0
for f in "results/rice_data/genotype_matrix.npz" "results/rice_data/trait_data.json"; do
    if [ -f "$f" ]; then
        echo "  [OK] $f"
    else
        echo "  [MISSING] $f"
        MISSING=1
    fi
done

if [ $MISSING -eq 1 ]; then
    echo "ERROR: Missing rice data files, skipping"
else
    T0=$(date +%s)
    python -u genomic_ensemble.py rice --full --no-plots 2>&1 | tee "logs/rice_ensemble_$(date +%Y%m%d_%H%M%S).log"
    RICE_EXIT=${PIPESTATUS[0]}
    T1=$(date +%s)
    echo "Rice finished in $(((T1-T0)/60)) min, exit=$RICE_EXIT"
    [ $RICE_EXIT -ne 0 ] && EXIT_CODE=$RICE_EXIT
fi

# ============================================================================
# 4. Maize Ensemble (Iranian)
# ============================================================================
echo ""
echo "======================================================================"
echo "[4/6] MAIZE ENSEMBLE (Iranian) — $(date)"
echo "======================================================================"

MISSING=0
for f in "data2/Iranian_Samples.csv" "data2/phenotype_iranian.csv"; do
    if [ -f "$f" ]; then
        SIZE=$(du -h "$f" | cut -f1)
        echo "  [OK] $f ($SIZE)"
    else
        echo "  [MISSING] $f"
        MISSING=1
    fi
done

if [ $MISSING -eq 1 ]; then
    echo "ERROR: Missing maize data files, skipping"
else
    T0=$(date +%s)
    python -u genomic_ensemble.py maize --full --no-plots 2>&1 | tee "logs/maize_ensemble_$(date +%Y%m%d_%H%M%S).log"
    MAIZE_EXIT=${PIPESTATUS[0]}
    T1=$(date +%s)
    echo "Maize finished in $(((T1-T0)/60)) min, exit=$MAIZE_EXIT"
    [ $MAIZE_EXIT -ne 0 ] && EXIT_CODE=$MAIZE_EXIT
fi

# ============================================================================
# 5. Soybean SoySNP50K
# ============================================================================
echo ""
echo "======================================================================"
echo "[5/6] SOYBEAN ENSEMBLE (SoySNP50K) — $(date)"
echo "======================================================================"

MISSING=0
for f in "results/soybean_SoySNP50K/genotype_matrix.npz" "results/soybean_SoySNP50K/trait_data.json"; do
    if [ -f "$f" ]; then
        echo "  [OK] $f"
    else
        echo "  [MISSING] $f"
        MISSING=1
    fi
done

if [ $MISSING -eq 1 ]; then
    echo "ERROR: Missing soybean data files, skipping"
else
    T0=$(date +%s)
    python -u genomic_ensemble.py soybean --full --no-plots 2>&1 | tee "logs/soybean_ensemble_$(date +%Y%m%d_%H%M%S).log"
    SOY_EXIT=${PIPESTATUS[0]}
    T1=$(date +%s)
    echo "Soybean finished in $(((T1-T0)/60)) min, exit=$SOY_EXIT"
    [ $SOY_EXIT -ne 0 ] && EXIT_CODE=$SOY_EXIT
fi

# ============================================================================
# 6. Wheat GABI iSELECT 90k
# ============================================================================
echo ""
echo "======================================================================"
echo "[6/6] WHEAT GABI ENSEMBLE (iSELECT 90k) — $(date)"
echo "======================================================================"

MISSING=0
for f in "results/wheat_GABI/genotype_matrix.npz" "results/wheat_GABI/trait_data.json"; do
    if [ -f "$f" ]; then
        echo "  [OK] $f"
    else
        echo "  [MISSING] $f"
        MISSING=1
    fi
done

if [ $MISSING -eq 1 ]; then
    echo "ERROR: Missing wheat GABI data files, skipping"
else
    T0=$(date +%s)
    python -u genomic_ensemble.py wheatgabi --full --no-plots 2>&1 | tee "logs/wheatgabi_ensemble_$(date +%Y%m%d_%H%M%S).log"
    WGABI_EXIT=${PIPESTATUS[0]}
    T1=$(date +%s)
    echo "Wheat GABI finished in $(((T1-T0)/60)) min, exit=$WGABI_EXIT"
    [ $WGABI_EXIT -ne 0 ] && EXIT_CODE=$WGABI_EXIT
fi

# ============================================================================
# 7. Unified plotting (once after all datasets)
# ============================================================================
echo ""
echo "======================================================================"
echo "[7/7] UNIFIED PLOTTING — $(date)"
echo "======================================================================"
T0=$(date +%s)
python -u genomic_ensemble.py plot --plot-only 2>&1 | tee "logs/plot_ensemble_$(date +%Y%m%d_%H%M%S).log"
PLOT_EXIT=${PIPESTATUS[0]}
T1=$(date +%s)
echo "Plotting finished in $(((T1-T0)/60)) min, exit=$PLOT_EXIT"
[ $PLOT_EXIT -ne 0 ] && EXIT_CODE=$PLOT_EXIT

# ============================================================================
# Done
# ============================================================================
TOTAL_END=$(date +%s)
echo ""
echo "======================================================================"
if [ $EXIT_CODE -eq 0 ]; then
    echo "ALL SUCCESS — Total time: $(((TOTAL_END-TOTAL_START)/60)) min — $(date)"
else
    echo "SOME FAILURES (exit=$EXIT_CODE) — Total time: $(((TOTAL_END-TOTAL_START)/60)) min — $(date)"
fi
echo "======================================================================"
exit $EXIT_CODE
